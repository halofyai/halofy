{
  "name": "halomem-kernel",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halofyai/halofy.git"
  },
  "description": "Halofy organizational memory kernel — vMMU, memory index, tiered storage, MCP syscall surface",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "halomem": "dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-hermetic-tests.mjs",
    "test:serial": "node scripts/run-hermetic-tests.mjs --maxWorkers=1",
    "test:pg": "vitest run test/pg-lane.test.ts --maxWorkers=1",
    "test:perf": "vitest run test/perf.test.ts test/usage-perf.test.ts --maxWorkers=1",
    "env:init": "node scripts/init-env.mjs",
    "test:watch": "vitest",
    "mcp": "tsx src/mcp/server.ts",
    "serve": "tsx src/http/main.ts",
    "serve:dev": "tsx scripts/serve-dev.mjs",
    "demo": "tsx src/demo.ts",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.3",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.13.1",
    "ulid": "^2.3.0",
    "yaml": "^2.6.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "ip-address": "^10.4.0"
  },
  "engines": {
    "node": "22.x"
  }
}
